diff --git a/tests/test_r1_budget_delivery.py b/tests/test_r1_budget_delivery.py
new file mode 100644
index 0000000..22ad1e9
--- /dev/null
+++ b/tests/test_r1_budget_delivery.py
@@ -0,0 +1,48 @@
+"""Budget stops deliver local saved results without restarting paid work."""
+import pytest
+
+from agent_runtime.task_loop import TaskLoop
+from agent_runtime.provider_usage import TaskProviderBudgetExceeded
+from agent_runtime.career.repository import TaskRepository
+from test_auto_apply import database
+from test_career_flow import settled
+from test_task_loop import Harness
+
+
+@pytest.mark.parametrize('delivery_mode', ['saved', 'empty', 'absent'])
+def test_provider_budget_stop_delivers_saved_results(database, delivery_mode):
+    class Model:
+        calls = 0
+
+        def invoke(self, messages, tools):
+            self.calls += 1
+            raise TaskProviderBudgetExceeded('provider_attempts')
+
+    model = Model()
+    repo = TaskRepository(database.session_factory)
+    harness = Harness()
+    saved = '- Recommended: Data Analyst | score 43.46 | https://example.com/jobs/1'
+    deliveries = []
+    if delivery_mode != 'absent':
+        def delivery(state):
+            deliveries.append(state['task_id'])
+            return [saved] if delivery_mode == 'saved' else []
+        harness.terminal_delivery = delivery
+    loop = TaskLoop(repo, harness, model_factory=lambda: model)
+    try:
+        task = loop.start('Find two matching jobs.', 'budget-delivery')
+        result = settled(repo, task['task_id'])
+        assert result['status'] == 'needs_input'
+        assert result['error']['code'] == 'provider_budget'
+        assert result['error']['reason'] == 'provider_attempts'
+        assert result['error']['retryable'] is False
+        messages = [m['text'] for m in result['messages'] if m['role'] == 'assistant']
+        assert len(messages) == 1
+        assert 'the requested work is not complete' in messages[0]
+        assert ('Saved so far:' in messages[0]) == (delivery_mode == 'saved')
+        assert (saved in messages[0]) == (delivery_mode == 'saved')
+        assert deliveries == ([] if delivery_mode == 'absent' else [task['task_id']])
+        assert model.calls == 1
+        assert not result['history']
+    finally:
+        loop.close()
diff --git a/tests/test_r1_material_lane.py b/tests/test_r1_material_lane.py
new file mode 100644
index 0000000..3620567
--- /dev/null
+++ b/tests/test_r1_material_lane.py
@@ -0,0 +1,34 @@
+"""The live lane must exercise its writer's semantic judge, without paid IO."""
+import json
+import pytest
+from test_application_pack import setup
+from test_integrated_p7 import pending
+from test_integrated_p8_material_live import use_revision_model
+from agent_runtime.application_pack.types import CoverLetter, ItemStatus
+
+
+@pytest.mark.parametrize('supported', [True, False])
+def test_live_lane_paraphrase_uses_injected_judge(setup, monkeypatch, supported):
+    monkeypatch.setenv('JOB_AGENT_OPT_MATERIAL_PATCHES', '0')
+    workflow, packs, *_ = setup
+    pack, item, original = pending(setup)
+    calls = []
+
+    class Writer:
+        def revise_blocks(self, artifact_type, context):
+            content = json.loads(json.dumps(original))
+            content['paragraphs'][0]['text'] = 'I am applying for the Backend Engineer role.'
+            content['paragraphs'][1]['text'] = 'I have built Python APIs.'
+            return CoverLetter.model_validate(content)
+
+        def verify_claims(self, claims):
+            calls.extend(claims)
+            return {c['claim_id'] for c in claims} if supported else set()
+
+    use_revision_model(workflow, Writer())
+    done = workflow.continue_item(pack.pack_id, item.pack_item_id)
+    assert len(calls) == 1
+    assert calls[0]['claim'] == 'I have built Python APIs.'
+    assert done.status == (ItemStatus.AWAITING_REVIEW if supported else ItemStatus.NEEDS_REVISION)
+    assert done.verification.passed is supported
+    assert done.revision_count == 1
